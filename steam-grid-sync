discover_client_steam_root() {
    local pid cwd exe candidate
    if command -v pgrep >/dev/null 2>&1; then
        pid="$(pgrep -n -x steam 2>/dev/null || true)"
        if [[ -n "$pid" ]]; then
            cwd="$(readlink -f "/proc/$pid/cwd" 2>/dev/null || true)"
            exe="$(readlink -f "/proc/$pid/exe" 2>/dev/null || true)"
            for candidate in "$cwd" "$(dirname "$exe" 2>/dev/null)" "$(dirname "$(dirname "$exe" 2>/dev/null)" 2>/dev/null)"; do
                if [[ -n "$candidate" && -d "$candidate/userdata" ]]; then readlink -f "$candidate"; return 0; fi
            done
        fi
    fi
    for candidate in "$HOME/.steam/root" "$HOME/.local/share/Steam" "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam"; do
        if [[ -d "$candidate/userdata" ]]; then readlink -f "$candidate"; return 0; fi
    done
    return 1
}

ensure_client_identity() {
    local client_dir
    client_dir="${CLIENT_ID_FILE%/*}"
    umask 077
    mkdir -p -- "$client_dir" "$KEY_DIR" || fail 6 "Could not create the passwordless-access directory."
    if [[ ! -s "$CLIENT_ID_FILE" ]]; then
        command -v od >/dev/null 2>&1 || fail 2 "Required command is missing: od"
        od -An -N16 -tx1 /dev/urandom | tr -d ' \n' >"$CLIENT_ID_FILE"
        chmod 0600 "$CLIENT_ID_FILE"
    fi
    CLIENT_ID="$(tr -cd 'a-fA-F0-9-' <"$CLIENT_ID_FILE")"
    [[ -n "$CLIENT_ID" ]] || fail 6 "The client identity file is invalid: $CLIENT_ID_FILE"
    KEY_MARKER="steam-grid-sync:$CLIENT_ID"
}

run_windows_powershell() {
