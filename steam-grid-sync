install_managed_key_windows() {
    local authorized_line="$1" marker="$2" line64 marker64 powershell_script
    line64="$(printf '%s' "$authorized_line" | base64 | tr -d '\n')"
    marker64="$(printf '%s' "$marker" | base64 | tr -d '\n')"
    powershell_script='$ErrorActionPreference = "Stop"
$line = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String("'"$line64"'"))
$marker = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String("'"$marker64"'"))
$principal = New-Object Security.Principal.WindowsPrincipal([Security.Principal.WindowsIdentity]::GetCurrent())
$isAdmin = $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
if ($isAdmin) {
    $path = Join-Path $env:ProgramData "ssh\administrators_authorized_keys"
} else {
    $path = Join-Path $env:USERPROFILE ".ssh\authorized_keys"
}
$directory = Split-Path -Parent $path
New-Item -ItemType Directory -Force -Path $directory | Out-Null
$existing = @()
if (Test-Path -LiteralPath $path) {
    Copy-Item -LiteralPath $path -Destination ($path + ".steam-grid-sync.backup") -Force
    $existing = @(Get-Content -LiteralPath $path)
}
$kept = @($existing | Where-Object { $_ -notlike ("*" + $marker) })
Set-Content -LiteralPath $path -Value @($kept + $line) -Encoding Ascii
if ($isAdmin) {
    & icacls.exe $path /inheritance:r /grant:r "*S-1-5-32-544:(F)" "*S-1-5-18:(F)" | Out-Null
} else {
    $userSid = [Security.Principal.WindowsIdentity]::GetCurrent().User.Value
    & icacls.exe $path /inheritance:r /grant:r ("*" + $userSid + ":(F)") "*S-1-5-18:(F)" | Out-Null
}
[Console]::Out.WriteLine($path)'
    run_windows_powershell "$powershell_script"
}

remove_managed_key_windows() {
    local marker="$1" marker64 powershell_script
    marker64="$(printf '%s' "$marker" | base64 | tr -d '\n')"
    powershell_script='$ErrorActionPreference = "Stop"
$marker = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String("'"$marker64"'"))
$principal = New-Object Security.Principal.WindowsPrincipal([Security.Principal.WindowsIdentity]::GetCurrent())
$isAdmin = $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
if ($isAdmin) { $path = Join-Path $env:ProgramData "ssh\administrators_authorized_keys" }
else { $path = Join-Path $env:USERPROFILE ".ssh\authorized_keys" }
if (Test-Path -LiteralPath $path) {
    Copy-Item -LiteralPath $path -Destination ($path + ".steam-grid-sync.backup") -Force
    $kept = @(Get-Content -LiteralPath $path | Where-Object { $_ -notlike ("*" + $marker) })
    Set-Content -LiteralPath $path -Value $kept -Encoding Ascii
}
[Console]::Out.WriteLine($path)'
    run_windows_powershell "$powershell_script"
}

install_managed_key_linux() {
    local authorized_line="$1" marker="$2" line64 marker64
    line64="$(printf '%s' "$authorized_line" | base64 | tr -d '\n')"
