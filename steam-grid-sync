    command -v iconv >/dev/null 2>&1 || return 1
    command -v base64 >/dev/null 2>&1 || return 1
    encoded="$(printf '%s' "$powershell_script" | iconv -f UTF-8 -t UTF-16LE | base64 | tr -d '\n')"
