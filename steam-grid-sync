setup_restricted_key() {
    local key_type key_data unused authorized_line remote_key_file sftp_server generated=0
    ensure_client_identity
    progress_update "Checking the managed passwordless key…"
    if test_dedicated_key; then
        show_info "Passwordless access is already enabled and working for $REMOTE_HOST."
        return 0
    fi
    command -v ssh-keygen >/dev/null 2>&1 || fail 2 "Required command is missing: ssh-keygen"
    if [[ ! -f "$KEY_FILE" || ! -f "$KEY_FILE.pub" ]]; then
        rm -f -- "$KEY_FILE" "$KEY_FILE.pub"
        ssh-keygen -q -t ed25519 -N '' -C "$KEY_MARKER" -f "$KEY_FILE" || fail 6 "Could not generate the dedicated SSH key."
        chmod 0600 "$KEY_FILE"; chmod 0644 "$KEY_FILE.pub"
        generated=1
    fi
    read -r key_type key_data unused <"$KEY_FILE.pub"
    [[ "$key_type" == "ssh-ed25519" && -n "$key_data" ]] || fail 6 "The dedicated public key is invalid."
    case "$RESOLVED_HOST_PLATFORM" in
        windows)
            progress_update "Installing the restricted read-only key on Windows…"
            authorized_line="restrict,command=\"C:/Windows/System32/OpenSSH/sftp-server.exe -R\" $key_type $key_data $KEY_MARKER"
            remote_key_file="$(install_managed_key_windows "$authorized_line" "$KEY_MARKER")" || fail 6 "Could not install the managed key on Windows. The SSH account may lack permission to update its authorized-keys file."
            ;;
        linux)
            progress_update "Installing the restricted read-only key on Linux…"
            sftp_server="$(remote_command 'for candidate in /usr/lib/openssh/sftp-server /usr/lib/ssh/sftp-server /usr/libexec/openssh/sftp-server; do if [ -x "$candidate" ]; then printf "%s\n" "$candidate"; exit 0; fi; done; command -v sftp-server 2>/dev/null' 2>/dev/null)" || true
            [[ -n "$sftp_server" ]] || fail 6 "Could not locate sftp-server on the Linux host."
            authorized_line="restrict,command=\"$sftp_server -R\" $key_type $key_data $KEY_MARKER"
            remote_key_file="$(install_managed_key_linux "$authorized_line" "$KEY_MARKER")" || fail 6 "Could not install the managed key on Linux."
            ;;
    esac
    if ! test_dedicated_key; then
        remove_managed_key_remote "$RESOLVED_HOST_PLATFORM" "$KEY_MARKER" >/dev/null 2>&1 || true
        ((generated)) && rm -f -- "$KEY_FILE" "$KEY_FILE.pub"
        fail 6 "The restricted key was installed but did not pass its read-only SFTP test. Its remote authorization was rolled back."
    fi
    remote_key_file="${remote_key_file%$'\r'}"
    remote_key_file="${remote_key_file//\\//}"
    DEDICATED_KEY_WORKS=1
    DEDICATED_KEY_BROKEN=0
    show_info "Passwordless artwork access is enabled.

The dedicated key cannot open a terminal, choose commands, forward connections, or modify host files. It is forced to read-only SFTP. It can read files available to this SSH account; it is not confined to Steam directories.

Remote authorization: $remote_key_file"
}

remove_restricted_key() {
    local platform
    [[ -s "$CLIENT_ID_FILE" ]] || { show_info "No managed passwordless key is recorded on this client."; return 0; }
    ensure_client_identity
    progress_update "Removing the managed passwordless key…"
    platform="$STATE_HOST_PLATFORM"
    if [[ "$platform" != "windows" && "$platform" != "linux" ]]; then platform="$(detect_host_platform)" || fail 4 "Could not detect the host platform for key removal."; fi
    remove_managed_key_remote "$platform" "$KEY_MARKER" >/dev/null || fail 6 "Could not remove the managed key from the host."
    rm -f -- "$KEY_FILE" "$KEY_FILE.pub"
    show_info "Passwordless artwork access was removed from the host and the dedicated local key was deleted."
}

if [[ "$COMMAND" == "remove-key" ]]; then remove_restricted_key; exit 0; fi

discover_host_details() {
    local discovered_root=""
    progress_update "Detecting the host operating system…"
    RESOLVED_HOST_PLATFORM="$(detect_host_platform)" || fail 4 "Could not detect whether the host runs Windows or Linux."
    while [[ -z "$discovered_root" ]]; do
        progress_update "Locating the running Steam installation on the $RESOLVED_HOST_PLATFORM host…"
        case "$RESOLVED_HOST_PLATFORM" in
            windows)
                if [[ -n "$WINDOWS_HOST_STEAM_PATH" ]]; then discovered_root="${WINDOWS_HOST_STEAM_PATH//\\//}"; else discovered_root="$(discover_windows_steam_root || true)"; fi
                ;;
            linux)
                if [[ -n "$LINUX_HOST_STEAM_PATH" ]]; then discovered_root="$LINUX_HOST_STEAM_PATH"; else discovered_root="$(discover_linux_steam_root || true)"; fi
                ;;
        esac
        [[ -n "$discovered_root" ]] && break
        if [[ "$MODE" == "gui" ]] && confirm_action "Steam could not be detected on $REMOTE_HOST.

Start Steam on the host computer, wait until it has opened, and choose Retry." "Retry" "Cancel"; then
            progress_start "Trying Steam discovery again…"
            continue
        fi
        fail 4 "Steam is not running on the host or its userdata directory could not be detected. Start Steam there and try again."
    done
    HOST_STEAM_ROOT="${discovered_root%/}"
}

if ((STATE_VALID)); then
    progress_update "Using the previously verified Steam location…"
    RESOLVED_HOST_PLATFORM="$STATE_HOST_PLATFORM"
    HOST_STEAM_ROOT="${STATE_HOST_STEAM_PATH%/}"
else
    ((CONNECTION_USES_DEDICATED_KEY == 0)) || fail 4 "Saved host discovery is unavailable, and the restricted key cannot run discovery commands. Repair the connection using a password."
    discover_host_details
fi
HOST_STEAM_ROOT="${HOST_STEAM_ROOT%/}"
HOST_SFTP_STEAM_ROOT="$HOST_STEAM_ROOT"
if [[ "$RESOLVED_HOST_PLATFORM" == "windows" && "$HOST_SFTP_STEAM_ROOT" =~ ^[A-Za-z]:/ ]]; then
    HOST_SFTP_STEAM_ROOT="/$HOST_SFTP_STEAM_ROOT"
fi
if [[ -n "$CLIENT_STEAM_PATH" ]]; then
    CLIENT_STEAM_ROOT="${CLIENT_STEAM_PATH%/}"
    [[ -d "$CLIENT_STEAM_ROOT/userdata" ]] || fail 4 "Configured client Steam path has no userdata directory: $CLIENT_STEAM_ROOT"
else
    CLIENT_STEAM_ROOT="$(discover_client_steam_root)" || fail 4 "Could not find Steam on this Linux client. Start Steam or set client_steam_path in $CONFIG_FILE."
fi

sftp_list_directory() {
    local remote_path="$1" output_file="$2" error_file="$3" batch_file="$4"
    [[ "$remote_path" != *$'\n'* && "$remote_path" != *'"'* ]] || return 1
    printf 'cd "%s"\nls -1\n' "$remote_path" >"$batch_file"
    sftp -q "${shared_ssh_options[@]}" -b "$batch_file" "$TARGET" >"$output_file" 2>"$error_file"
}

REMOTE_USERDATA="$HOST_SFTP_STEAM_ROOT/userdata"
progress_update "Reading Steam users from the host…"
if ! sftp_list_directory "$REMOTE_USERDATA" "$WORK_DIR/remote-users.out" "$WORK_DIR/remote-users.err" "$WORK_DIR/remote-users.batch"; then
    detail="$(tail -n 3 "$WORK_DIR/remote-users.err" | tr '\n' ' ')"
    fail 4 "Could not list the host userdata directory: $REMOTE_USERDATA${detail:+ ($detail)}"
fi

declare -A remote_user_ids=() local_user_ids=()
while IFS= read -r remote_line; do
    remote_line="${remote_line%$'\r'}"; remote_name="${remote_line##*/}"; remote_name="${remote_name%/}"
    [[ "$remote_name" =~ ^[0-9]+$ ]] && remote_user_ids["$remote_name"]=1
done <"$WORK_DIR/remote-users.out"
((${#remote_user_ids[@]})) || fail 4 "The detected Steam userdata directory contains no numeric Steam user directories: $REMOTE_USERDATA"
if ((STATE_VALID == 0)); then
    write_host_state "$RESOLVED_HOST_PLATFORM" "$HOST_STEAM_ROOT"
    STATE_VALID=1
fi

if [[ "$COMMAND" == "test-connection" ]]; then
    auth_description="password or a normal SSH key"
    ((DEDICATED_KEY_WORKS)) && auth_description="the managed read-only key"
    show_info "Connection succeeded.

Host: $REMOTE_HOST:$REMOTE_PORT
Platform: $RESOLVED_HOST_PLATFORM
Steam: $HOST_STEAM_ROOT
Authentication: $auth_description
Steam users found: ${#remote_user_ids[@]}"
    exit 0
fi

if [[ "$COMMAND" == "setup-key" ]]; then setup_restricted_key; exit 0; fi

if [[ "$COMMAND" == "sync" && "$MODE" != "headless" && ( "$STATE_WRITTEN" -eq 1 || "$DEDICATED_KEY_BROKEN" -eq 1 ) && "$DEDICATED_KEY_WORKS" -eq 0 ]]; then
    key_prompt="Enable passwordless artwork syncing for future runs?

This creates a dedicated key instead of storing your password. It cannot open a terminal, choose commands, forward connections, or modify files; the host forces it to use read-only SFTP.

Read-only SFTP can read other files available to this SSH account and is not confined to Steam directories."
    [[ "$DEDICATED_KEY_BROKEN" -eq 0 ]] || key_prompt="The previously managed passwordless key is no longer accepted.

Repair it now using this authenticated connection? The replacement remains restricted to read-only SFTP."
    if confirm_action "$key_prompt" "Enable" "Not Now"; then setup_restricted_key; fi
    progress_start "Comparing Steam artwork…"
fi

shopt -s nullglob
for local_user_dir in "$CLIENT_STEAM_ROOT/userdata"/*; do
    [[ -d "$local_user_dir" ]] || continue
    local_user_id="${local_user_dir##*/}"
    [[ "$local_user_id" =~ ^[0-9]+$ ]] && local_user_ids["$local_user_id"]=1
done

selected_user_ids=()
if [[ -n "$STEAM_USER_ID" ]]; then
    [[ -n "${remote_user_ids[$STEAM_USER_ID]+set}" ]] || fail 4 "Steam user ID $STEAM_USER_ID is not present on the host."
    [[ -n "${local_user_ids[$STEAM_USER_ID]+set}" ]] || fail 4 "Steam user ID $STEAM_USER_ID is not present on the client."
    selected_user_ids+=("$STEAM_USER_ID")
else
    while IFS= read -r user_id; do
        [[ -n "$user_id" && -n "${remote_user_ids[$user_id]+set}" ]] && selected_user_ids+=("$user_id")
    done < <(printf '%s\n' "${!local_user_ids[@]}" | sort -n)
fi
((${#selected_user_ids[@]})) || fail 4 "No numeric Steam userdata IDs are present on both host and client."

image_name_parts() {
    local name="$1"
    if [[ "$name" =~ ^([-A-Za-z0-9_]+)\.([Pp][Nn][Gg]|[Jj][Pp][Ee]?[Gg]|[Ww][Ee][Bb][Pp]|[Tt][Gg][Aa]|[Ii][Cc][Oo])$ ]]; then
        IMAGE_STEM="${BASH_REMATCH[1],,}"; IMAGE_EXT="${BASH_REMATCH[2],,}"; return 0
    fi
    return 1
}
extension_rank() { case "$1" in png) printf 1;; jpg) printf 2;; jpeg) printf 3;; webp) printf 4;; tga) printf 5;; ico) printf 6;; *) printf 99;; esac; }

total_added=0 total_replaced=0 users_with_changes=0 users_checked=0
sync_user_artwork() {
    local user_id="$1" remote_grid="$HOST_SFTP_STEAM_ROOT/userdata/$1/config/grid" local_grid="$CLIENT_STEAM_ROOT/userdata/$1/config/grid" user_work="$WORK_DIR/user-$1"
    local remote_line remote_name local_file local_name rank slot staged_file temporary_destination had_slot matching_count slot_now_exists existing_file detail
    local user_added=0 user_replaced=0
    local -a slots_to_download=()
    local -A local_slots=() remote_files=() remote_ranks=()
    progress_update "Checking artwork for Steam user $user_id…"
    mkdir -p -- "$user_work" "$local_grid" || fail 6 "Could not prepare artwork directories for Steam user $user_id."
    if ! sftp_list_directory "$remote_grid" "$user_work/list.out" "$user_work/list.err" "$user_work/list.batch"; then
        progress_update "Skipping Steam user $user_id because the host has no readable grid directory."
        return 0
    fi
    ((users_checked += 1))
    for local_file in "$local_grid"/*; do
        [[ -f "$local_file" ]] || continue
        local_name="${local_file##*/}"; image_name_parts "$local_name" && local_slots["$IMAGE_STEM"]=1
    done
    while IFS= read -r remote_line; do
        remote_line="${remote_line%$'\r'}"; remote_name="${remote_line##*/}"
        image_name_parts "$remote_name" || continue
        rank="$(extension_rank "$IMAGE_EXT")"
        if [[ -z "${remote_files[$IMAGE_STEM]+set}" || "$rank" -lt "${remote_ranks[$IMAGE_STEM]}" ]]; then remote_files["$IMAGE_STEM"]="$remote_name"; remote_ranks["$IMAGE_STEM"]="$rank"; fi
    done <"$user_work/list.out"
    while IFS= read -r slot; do
        [[ -n "$slot" ]] || continue
        [[ "$CONFLICT_POLICY" != "preserve-client" || -z "${local_slots[$slot]+set}" ]] && slots_to_download+=("$slot")
    done < <(printf '%s\n' "${!remote_files[@]}" | sort)
    ((${#slots_to_download[@]})) || return 0
    progress_update "Downloading ${#slots_to_download[@]} artwork file(s) for Steam user $user_id…"
    mkdir -p -- "$user_work/downloads" || fail 6 "Could not prepare downloads for Steam user $user_id."
    {
        printf 'cd "%s"\n' "$remote_grid"; printf 'lcd "%s"\n' "$user_work/downloads"
        for slot in "${slots_to_download[@]}"; do printf 'get "%s"\n' "${remote_files[$slot]}"; done
    } >"$user_work/download.batch"
    if ! sftp -q "${shared_ssh_options[@]}" -b "$user_work/download.batch" "$TARGET" >"$user_work/download.out" 2>"$user_work/download.err"; then
        detail="$(tail -n 3 "$user_work/download.err" | tr '\n' ' ')"; fail 5 "Artwork download failed for Steam user $user_id.${detail:+ $detail}"
    fi
    for slot in "${slots_to_download[@]}"; do
        remote_name="${remote_files[$slot]}"; staged_file="$user_work/downloads/$remote_name"
        [[ -f "$staged_file" ]] || fail 5 "The host did not provide the expected file: $remote_name"
        had_slot=0
        matching_count=0
        for local_file in "$local_grid"/*; do
            [[ -f "$local_file" ]] || continue
            local_name="${local_file##*/}"
            if image_name_parts "$local_name" && [[ "$IMAGE_STEM" == "$slot" ]]; then
                had_slot=1
                ((matching_count += 1))
            fi
        done
        [[ "$CONFLICT_POLICY" != "preserve-client" || "$had_slot" -eq 0 ]] || continue
        if [[ "$CONFLICT_POLICY" == "host-wins" && "$matching_count" -eq 1 && -f "$local_grid/$remote_name" ]] && cmp -s -- "$staged_file" "$local_grid/$remote_name"; then
            continue
        fi
        temporary_destination="$local_grid/.steam-grid-sync-$remote_name.$$"
        cp -- "$staged_file" "$temporary_destination" || fail 6 "Could not stage $remote_name for Steam user $user_id."
        chmod 0644 "$temporary_destination" 2>/dev/null || true
        if [[ "$CONFLICT_POLICY" == "host-wins" ]]; then
            mv -f -- "$temporary_destination" "$local_grid/$remote_name" || fail 6 "Could not install $remote_name for Steam user $user_id."
            for existing_file in "$local_grid"/*; do
                [[ -f "$existing_file" && "$existing_file" != "$local_grid/$remote_name" ]] || continue
                local_name="${existing_file##*/}"
                if image_name_parts "$local_name" && [[ "$IMAGE_STEM" == "$slot" ]]; then rm -f -- "$existing_file" || fail 6 "Could not remove superseded client artwork $local_name."; fi
            done
            if ((had_slot)); then ((user_replaced += 1)); else ((user_added += 1)); fi
        else
            slot_now_exists=0
            for existing_file in "$local_grid"/*; do
                [[ -f "$existing_file" ]] || continue
                local_name="${existing_file##*/}"
                if image_name_parts "$local_name" && [[ "$IMAGE_STEM" == "$slot" ]]; then slot_now_exists=1; break; fi
            done
            if ((slot_now_exists)); then rm -f -- "$temporary_destination"; continue; fi
            mv -n -- "$temporary_destination" "$local_grid/$remote_name" || fail 6 "Could not install $remote_name for Steam user $user_id."
            if [[ -e "$temporary_destination" ]]; then rm -f -- "$temporary_destination"; else ((user_added += 1)); fi
        fi
    done
    if ((user_added + user_replaced > 0)); then ((users_with_changes += 1)); ((total_added += user_added)); ((total_replaced += user_replaced)); fi
}

for selected_user_id in "${selected_user_ids[@]}"; do sync_user_artwork "$selected_user_id"; done
if ((total_added + total_replaced == 0)); then
    progress_stop
    show_info "Artwork is already up to date across ${#selected_user_ids[@]} matching Steam user(s)."
    [[ "$MODE" == "headless" ]] && printf 'RESULT=unchanged ADDED=0 REPLACED=0 USERS=%d\n' "${#selected_user_ids[@]}"
    exit 0
fi

summary="Added $total_added and replaced $total_replaced artwork slot(s) across $users_with_changes Steam user(s)."
progress_stop
[[ "$MODE" == "headless" ]] && printf 'RESULT=changed ADDED=%d REPLACED=%d USERS=%d\n' "$total_added" "$total_replaced" "$users_with_changes"

restart_steam() {
    steam -shutdown >/dev/null 2>&1 || true
    local attempt
    for attempt in {1..30}; do pgrep -x steam >/dev/null 2>&1 || break; sleep 1; done
    if pgrep -x steam >/dev/null 2>&1; then show_error "Artwork was synchronized, but Steam did not close within 30 seconds. It was not force-terminated."; return 7; fi
    nohup steam >/dev/null 2>&1 & disown || true
}
if ! pgrep -x steam >/dev/null 2>&1; then
    show_info "$summary

The new artwork will appear when Steam is next started."
    exit 0
fi
case "$RESTART_POLICY" in
    always)
        restart_steam || exit $?
        show_info "$summary

Steam has been restarted to load the new artwork."
        ;;
    never)
        show_info "$summary

The new artwork will appear after Steam is next restarted."
        ;;
    ask)
        if confirm_action "$summary

Restart Steam now to load it?" "Restart Steam" "Later"; then
            restart_steam || exit $?
            show_info "Steam has been restarted and the new artwork is ready."
        else
            show_info "The new artwork will appear after Steam is next restarted."
        fi
        ;;
esac
exit 0
