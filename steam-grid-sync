fingerprint_from_key_file() {
    local key_file="$1" preferred="$WORK_DIR/preferred-host-key"
    if grep -m1 ' ssh-ed25519 ' "$key_file" >"$preferred"; then :; else grep -v '^#' "$key_file" | head -n 1 >"$preferred"; fi
    [[ -s "$preferred" ]] || return 1
    ssh-keygen -lf "$preferred" | awk 'NR == 1 { print $2 }'
}

host_key_preflight() {
    local lookup known_lines="$WORK_DIR/known-host-lines" known_keys="$WORK_DIR/known-host-values"
    local scanned_keys="$WORK_DIR/scanned-host-values" intersection="$WORK_DIR/host-key-intersection"
    local old_fingerprint backup known_hosts_dir
    lookup="$(host_lookup_name)"
    known_hosts_dir="${KNOWN_HOSTS_FILE%/*}"
    [[ "$known_hosts_dir" != "$KNOWN_HOSTS_FILE" ]] || known_hosts_dir="."
    mkdir -p -- "$known_hosts_dir" || fail 6 "Could not create trusted-host directory: $known_hosts_dir"
    touch "$KNOWN_HOSTS_FILE" || fail 6 "Could not access trusted-host file: $KNOWN_HOSTS_FILE"
    chmod 0600 "$KNOWN_HOSTS_FILE" 2>/dev/null || true
    if ! ssh-keyscan -T "$CONNECT_TIMEOUT" -p "$REMOTE_PORT" -t ed25519,ecdsa,rsa "$REMOTE_HOST" >"$WORK_DIR/scanned-host-keys" 2>"$WORK_DIR/keyscan.err"; then
        :
    fi
    if [[ ! -s "$WORK_DIR/scanned-host-keys" ]]; then
        if [[ "$COMMAND" == "show-fingerprint" ]]; then
            ssh-keygen -F "$lookup" -f "$KNOWN_HOSTS_FILE" 2>/dev/null | grep -v '^#' >"$known_lines" || true
            if [[ -s "$known_lines" ]]; then
                old_fingerprint="$(fingerprint_from_key_file "$known_lines" 2>/dev/null || printf unknown)"
                show_info "Trusted fingerprint for $REMOTE_HOST:$REMOTE_PORT:
$old_fingerprint

The host is not currently answering, so its presented identity could not be compared."
                exit 0
            fi
        fi
        fail 3 "No SSH server answered at $REMOTE_HOST:$REMOTE_PORT.

Make sure the host is on, reachable, and has SSH Server installed and running. Open Connection Settings → SSH Server help for setup instructions."
    fi
    CURRENT_HOST_FINGERPRINT="$(fingerprint_from_key_file "$WORK_DIR/scanned-host-keys")" || fail 3 "The SSH server did not offer a usable host identity."
    mv -- "$WORK_DIR/preferred-host-key" "$WORK_DIR/presented-host-key" || fail 3 "Could not save the presented SSH host identity."
    ssh-keygen -F "$lookup" -f "$KNOWN_HOSTS_FILE" 2>/dev/null | grep -v '^#' >"$known_lines" || true
    if [[ ! -s "$known_lines" ]]; then
        [[ "$MODE" != "headless" ]] || fail 3 "The SSH identity for $REMOTE_HOST is not trusted. Run an interactive connection first. Presented fingerprint: $CURRENT_HOST_FINGERPRINT"
        if ! confirm_action "First connection to $REMOTE_HOST:$REMOTE_PORT.

SSH fingerprint:
$CURRENT_HOST_FINGERPRINT

Trust this host and continue? Only approve this if this is the computer you intended to reach." "Trust and Continue" "Cancel"; then
            exit 3
        fi
        cat "$WORK_DIR/presented-host-key" >>"$KNOWN_HOSTS_FILE" || fail 3 "Could not save the trusted SSH host identity."
        return
    fi
    awk '!/^#/ { print $2 " " $3 }' "$known_lines" | sort -u >"$known_keys"
    awk '!/^#/ { print $2 " " $3 }' "$WORK_DIR/scanned-host-keys" | sort -u >"$scanned_keys"
    comm -12 "$known_keys" "$scanned_keys" >"$intersection"
    [[ -s "$intersection" ]] && return
    old_fingerprint="$(fingerprint_from_key_file "$known_lines" 2>/dev/null || printf unknown)"
    [[ "$MODE" != "headless" ]] || fail 3 "The SSH identity for $REMOTE_HOST changed. Refusing the connection. Old: $old_fingerprint New: $CURRENT_HOST_FINGERPRINT"
    if ! confirm_action "WARNING: the SSH identity for $REMOTE_HOST changed.

Previously trusted: $old_fingerprint
Presented now:      $CURRENT_HOST_FINGERPRINT

This can happen after reinstalling SSH or replacing the computer, but can also indicate interception. Replace it only after verifying the new fingerprint on the host." "I Verified — Replace" "Cancel"; then
        exit 3
    fi
    backup="$KNOWN_HOSTS_FILE.backup-$(date +%Y%m%d-%H%M%S)"
    cp -p -- "$KNOWN_HOSTS_FILE" "$backup" || fail 6 "Could not back up trusted-host file."
    ssh-keygen -R "$lookup" -f "$KNOWN_HOSTS_FILE" >/dev/null || fail 6 "Could not replace the old host identity."
    cat "$WORK_DIR/presented-host-key" >>"$KNOWN_HOSTS_FILE" || fail 3 "Could not save the trusted SSH host identity."
}

