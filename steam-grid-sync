#!/usr/bin/env bash

if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
    printf 'steam-grid-sync requires Bash 4.4 or newer.\n' >&2
    exit 2
fi

set -u
set -o pipefail

PROGRAM_NAME="Steam Artwork Sync"
PROGRAM_COMMAND="steam-grid-sync"

if [[ -n "${XDG_CONFIG_HOME:-}" && "${XDG_CONFIG_HOME}" == /* ]]; then
    DEFAULT_CONFIG_DIR="$XDG_CONFIG_HOME/steam-grid-sync"
else
    DEFAULT_CONFIG_DIR="$HOME/.config/steam-grid-sync"
fi
CONFIG_FILE="${STEAM_GRID_CONFIG:-$DEFAULT_CONFIG_DIR/config}"

if [[ -n "${XDG_STATE_HOME:-}" && "${XDG_STATE_HOME}" == /* ]]; then
    DEFAULT_STATE_DIR="$XDG_STATE_HOME/steam-grid-sync"
else
    DEFAULT_STATE_DIR="$HOME/.local/state/steam-grid-sync"
fi
if [[ -n "${XDG_DATA_HOME:-}" && "${XDG_DATA_HOME}" == /* ]]; then
    DEFAULT_DATA_DIR="$XDG_DATA_HOME/steam-grid-sync"
else
    DEFAULT_DATA_DIR="$HOME/.local/share/steam-grid-sync"
fi
STATE_FILE="${STEAM_GRID_STATE:-$DEFAULT_STATE_DIR/host-state}"
KNOWN_HOSTS_FILE="${STEAM_GRID_KNOWN_HOSTS:-$DEFAULT_CONFIG_DIR/known_hosts}"
KEY_DIR="${STEAM_GRID_KEY_DIR:-$DEFAULT_DATA_DIR/keys}"
KEY_FILE="$KEY_DIR/id_ed25519"
CLIENT_ID_FILE="$DEFAULT_DATA_DIR/client-id"

MODE=""
COMMAND="sync"
RESTART_OVERRIDE=""
WORK_DIR=""
CONTROL_SOCKET=""
MASTER_STARTED=0
CURRENT_HOST_FINGERPRINT=""
STATE_VALID=0
STATE_WRITTEN=0
DEDICATED_KEY_WORKS=0
DEDICATED_KEY_BROKEN=0
CONNECTION_USES_DEDICATED_KEY=0
PROGRESS_ACTIVE=0
PROGRESS_FD=""
PROGRESS_PID=""

CLI_HOST=""
CLI_USER=""
CLI_PORT=""
CLI_HOST_PLATFORM=""
CLI_WINDOWS_HOST_STEAM_PATH=""
CLI_LINUX_HOST_STEAM_PATH=""
CLI_CLIENT_STEAM_PATH=""
CLI_STEAM_USER_ID=""
CLI_CONFLICT_POLICY=""
CLI_RESTART_POLICY=""
CLI_CONNECT_TIMEOUT=""

CFG_HOST=""
CFG_USER=""
CFG_PORT=""
CFG_HOST_PLATFORM=""
CFG_WINDOWS_HOST_STEAM_PATH=""
CFG_LINUX_HOST_STEAM_PATH=""
CFG_CLIENT_STEAM_PATH=""
CFG_STEAM_USER_ID=""
CFG_CONFLICT_POLICY=""
CFG_RESTART_POLICY=""
CFG_CONNECT_TIMEOUT=""
CFG_CONFIG_VERSION=""

STATE_VERSION=""
STATE_HOST=""
STATE_USER=""
STATE_PORT=""
STATE_HOST_KEY_FINGERPRINT=""
STATE_HOST_PLATFORM=""
STATE_HOST_STEAM_PATH=""

script_path="$(readlink -f -- "$0")"

askpass_helper() {
    local prompt="${1:-SSH authentication required}" askpass_user askpass_host
    if [[ "${SSH_ASKPASS_PROMPT:-}" == "confirm" ]]; then
        if command -v zenity >/dev/null 2>&1; then
            zenity --question --title="$PROGRAM_NAME — SSH verification" --text="$prompt"
        elif command -v kdialog >/dev/null 2>&1; then
            kdialog --title "$PROGRAM_NAME — SSH verification" --yesno "$prompt"
        else
            return 1
        fi
        return
    fi
    askpass_user="${STEAM_GRID_ASKPASS_USER:-the configured SSH user}"
    askpass_host="${STEAM_GRID_ASKPASS_HOST:-the configured host}"
    if [[ "$prompt" != Enter\ passphrase\ for\ key\ * ]]; then
        prompt="Steam Artwork Sync needs the SSH account password for:

User: $askpass_user
Host: $askpass_host

It will use this connection to read Steam artwork from the host and copy missing artwork to this computer. The password is not stored.

On Windows, enter the account password—not a Windows Hello PIN."
    fi
    if command -v zenity >/dev/null 2>&1; then
        zenity --entry --hide-text --title="$PROGRAM_NAME — SSH authentication" --text="$prompt"
    elif command -v kdialog >/dev/null 2>&1; then
        kdialog --title "$PROGRAM_NAME — SSH authentication" --password "$prompt"
    else
        return 1
    fi
}

if [[ "${STEAM_GRID_ASKPASS_HELPER:-0}" == "1" ]]; then
    askpass_helper "${1:-}"
    exit $?
fi

usage() {
    cat <<'EOF'
Usage:
  steam-grid-sync [sync] [MODE] [OPTIONS]
  steam-grid-sync init [--gui] [--config PATH]
  steam-grid-sync setup-key [--gui] [--config PATH]
  steam-grid-sync remove-key [--gui] [--config PATH]
  steam-grid-sync test-connection [--gui] [--config PATH]
  steam-grid-sync connection-settings [--gui] [--config PATH]
  steam-grid-sync show-fingerprint [--gui] [--config PATH]
  steam-grid-sync ssh-help [--gui]
  steam-grid-sync show-config [--config PATH]

Commands:
  sync                         Synchronize artwork (the default command).
  init                         Interactively create the configuration file.
  setup-key                    Enable or repair restricted passwordless access.
  remove-key                   Remove this client's managed key from the host.
  test-connection              Verify SSH, Steam discovery, and userdata access.
  connection-settings          Open connection management (GUI with --gui).
  show-fingerprint             Show the host identity currently presented.
  ssh-help                     Show Windows and Linux SSH server setup help.
  show-config                  Print the configuration path and contents.

Modes:
  --gui                        Use graphical progress windows and dialogs.
  --non-interactive            Never prompt; require trusted key authentication.

Connection options:
  --host HOST                  SSH hostname or address.
  --user USER                  SSH username.
  --port PORT                  SSH port.
  --connect-timeout SECONDS    Connection timeout.

Steam options:
  --host-platform PLATFORM     auto, windows, or linux.
  --windows-host-steam-path PATH
                               Explicit Steam root when the host is Windows.
  --linux-host-steam-path PATH Explicit Steam root when the host is Linux.
  --client-steam-path PATH     Explicit client Steam root; skips local discovery.
  --steam-user-id ID           Sync only this userdata ID instead of all matches.
  --conflict-policy POLICY     preserve-client (default) or host-wins.

Restart options:
  --restart-policy POLICY      ask, always, or never.
  --restart-steam-if-changed   Alias for --restart-policy always.
  --no-restart                 Alias for --restart-policy never.

General options:
  --config PATH                Use a different configuration file.
  -h, --help                   Show this help.

Precedence is command-line options, environment variables, configuration,
then automatic discovery and defaults. Passwords are never stored.
EOF
}

require_option_value() {
    local option="$1" remaining="$2"
    ((remaining >= 2)) || { printf 'Option %s requires a value.\n' "$option" >&2; exit 2; }
}

if (($#)) && [[ "$1" == "sync" || "$1" == "init" || "$1" == "setup-key" || "$1" == "remove-key" || "$1" == "test-connection" || "$1" == "connection-settings" || "$1" == "show-fingerprint" || "$1" == "ssh-help" || "$1" == "show-config" ]]; then
    COMMAND="$1"
    shift
elif (($#)) && [[ "$1" != -* ]]; then
    printf 'Unknown command: %s\n' "$1" >&2
    usage >&2
    exit 2
fi

while (($#)); do
    case "$1" in
        --gui)
            [[ -z "$MODE" || "$MODE" == "gui" ]] || { printf 'Only one mode may be selected.\n' >&2; exit 2; }
            MODE="gui"
            ;;
        --non-interactive)
            [[ -z "$MODE" || "$MODE" == "headless" ]] || { printf 'Only one mode may be selected.\n' >&2; exit 2; }
            MODE="headless"
            ;;
        --config) require_option_value "$1" "$#"; CONFIG_FILE="$2"; shift ;;
        --host) require_option_value "$1" "$#"; CLI_HOST="$2"; shift ;;
        --user) require_option_value "$1" "$#"; CLI_USER="$2"; shift ;;
        --port) require_option_value "$1" "$#"; CLI_PORT="$2"; shift ;;
        --connect-timeout) require_option_value "$1" "$#"; CLI_CONNECT_TIMEOUT="$2"; shift ;;
        --host-platform) require_option_value "$1" "$#"; CLI_HOST_PLATFORM="$2"; shift ;;
        --windows-host-steam-path) require_option_value "$1" "$#"; CLI_WINDOWS_HOST_STEAM_PATH="$2"; shift ;;
        --linux-host-steam-path) require_option_value "$1" "$#"; CLI_LINUX_HOST_STEAM_PATH="$2"; shift ;;
        --client-steam-path) require_option_value "$1" "$#"; CLI_CLIENT_STEAM_PATH="$2"; shift ;;
        --steam-user-id) require_option_value "$1" "$#"; CLI_STEAM_USER_ID="$2"; shift ;;
        --conflict-policy) require_option_value "$1" "$#"; CLI_CONFLICT_POLICY="$2"; shift ;;
        --restart-policy) require_option_value "$1" "$#"; CLI_RESTART_POLICY="$2"; shift ;;
        --restart-steam-if-changed) RESTART_OVERRIDE="always" ;;
        --no-restart) RESTART_OVERRIDE="never" ;;
        -h|--help) usage; exit 0 ;;
        *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

if [[ -z "$MODE" ]]; then
    if [[ -t 0 && -t 1 ]]; then MODE="terminal"; else MODE="gui"; fi
fi

progress_start() {
    local message="$1"
    ((PROGRESS_ACTIVE == 0)) || { progress_update "$message"; return; }
    if [[ "$MODE" == "gui" ]] && command -v zenity >/dev/null 2>&1; then
        exec {PROGRESS_FD}> >(zenity --progress --pulsate --no-cancel --auto-close \
            --width=520 --title="$PROGRAM_NAME" --text="$message" 2>/dev/null)
        PROGRESS_PID=$!
        PROGRESS_ACTIVE=1
    elif [[ "$MODE" != "gui" ]]; then
        printf '%s\n' "$message"
    fi
}

progress_update() {
    local message="$1"
    if ((PROGRESS_ACTIVE)) && [[ -n "$PROGRESS_FD" ]]; then
        printf '# %s\n' "$message" >&"$PROGRESS_FD" 2>/dev/null || true
    elif [[ "$MODE" != "gui" ]]; then
        printf '%s\n' "$message"
    fi
}

progress_stop() {
    if ((PROGRESS_ACTIVE)); then
        if [[ -n "$PROGRESS_FD" ]]; then exec {PROGRESS_FD}>&- 2>/dev/null || true; fi
        if [[ -n "$PROGRESS_PID" ]]; then wait "$PROGRESS_PID" 2>/dev/null || true; fi
        PROGRESS_ACTIVE=0
        PROGRESS_FD=""
        PROGRESS_PID=""
    fi
}

show_error() {
    local message="$1"
    progress_stop
    if [[ "$MODE" == "gui" ]]; then
        if command -v zenity >/dev/null 2>&1; then
            zenity --error --title="$PROGRAM_NAME" --text="$message" >/dev/null 2>&1 || true
        elif command -v kdialog >/dev/null 2>&1; then
            kdialog --title "$PROGRAM_NAME" --error "$message" >/dev/null 2>&1 || true
        else
            printf 'ERROR: %s\n' "$message" >&2
        fi
    else
        printf 'ERROR: %s\n' "$message" >&2
    fi
}

show_info() {
    local message="$1"
    progress_stop
    if [[ "$MODE" == "gui" ]]; then
        if command -v zenity >/dev/null 2>&1; then
            zenity --info --title="$PROGRAM_NAME" --text="$message" >/dev/null 2>&1 || true
        elif command -v kdialog >/dev/null 2>&1; then
            kdialog --title "$PROGRAM_NAME" --msgbox "$message" >/dev/null 2>&1 || true
        else
            printf '%s\n' "$message"
        fi
    else
        printf '%s\n' "$message"
    fi
}

confirm_action() {
    local message="$1" yes_label="${2:-Continue}" no_label="${3:-Cancel}"
    progress_stop
    if [[ "$MODE" == "gui" ]]; then
        if command -v zenity >/dev/null 2>&1; then
            zenity --question --title="$PROGRAM_NAME" --ok-label="$yes_label" --cancel-label="$no_label" --text="$message"
        elif command -v kdialog >/dev/null 2>&1; then
            kdialog --title "$PROGRAM_NAME" --yes-label "$yes_label" --no-label "$no_label" --yesno "$message"
        else
            return 1
        fi
    else
        local answer
        read -r -p "$message [y/N] " answer
        [[ "$answer" == "y" || "$answer" == "Y" || "$answer" == "yes" || "$answer" == "YES" ]]
    fi
}

fail() { local exit_code="$1"; shift; show_error "$*"; exit "$exit_code"; }

trim_value() {
    local value="$1"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s' "$value"
}

load_config() {
    local line key value line_number=0
    [[ -f "$CONFIG_FILE" ]] || return 1
    while IFS= read -r line || [[ -n "$line" ]]; do
        ((line_number += 1))
        line="$(trim_value "$line")"
        [[ -z "$line" || "$line" == \#* ]] && continue
        [[ "$line" == *=* ]] || fail 2 "Invalid configuration line $line_number in $CONFIG_FILE."
        key="$(trim_value "${line%%=*}")"
        value="$(trim_value "${line#*=}")"
        case "$key" in
            config_version) CFG_CONFIG_VERSION="$value" ;;
            host) CFG_HOST="$value" ;;
            user) CFG_USER="$value" ;;
            port) CFG_PORT="$value" ;;
            host_platform) CFG_HOST_PLATFORM="$value" ;;
            windows_host_steam_path) CFG_WINDOWS_HOST_STEAM_PATH="$value" ;;
            linux_host_steam_path) CFG_LINUX_HOST_STEAM_PATH="$value" ;;
            client_steam_path) CFG_CLIENT_STEAM_PATH="$value" ;;
            steam_user_id) CFG_STEAM_USER_ID="$value" ;;
            conflict_policy) CFG_CONFLICT_POLICY="$value" ;;
            restart_policy) CFG_RESTART_POLICY="$value" ;;
            connect_timeout) CFG_CONNECT_TIMEOUT="$value" ;;
            *) fail 2 "Unknown configuration key '$key' on line $line_number in $CONFIG_FILE." ;;
        esac
    done <"$CONFIG_FILE"
}

gui_entry() {
    local title="$1" prompt="$2" default_value="${3:-}"
    if command -v zenity >/dev/null 2>&1; then
        zenity --entry --title="$title" --text="$prompt" --entry-text="$default_value"
    elif command -v kdialog >/dev/null 2>&1; then
        kdialog --title "$title" --inputbox "$prompt" "$default_value"
    else
        return 1
    fi
}

show_ssh_help() {
    show_info "The host computer must run an SSH server before artwork can be synchronized.

Windows 10/11:
1. Open Settings → System → Optional features.
2. Install OpenSSH Server.
3. Open Services, start ‘OpenSSH SSH Server’, and set it to Automatic.
4. Ensure the OpenSSH Server firewall rule is enabled.

Linux (Debian/Ubuntu):
1. Install it with: sudo apt install openssh-server
2. Start it with: sudo systemctl enable --now ssh

Other Linux distributions provide the same service as openssh-server, usually named sshd.

Then run Test Connection again."
}

connection_settings_menu() {
    local choice
    [[ "$MODE" != "headless" ]] || fail 2 "Connection settings are interactive."
    if [[ "$MODE" == "gui" ]] && command -v zenity >/dev/null 2>&1; then
        choice="$(zenity --list --title="$PROGRAM_NAME — Connection Settings" \
            --width=650 --height=360 --hide-column=1 \
            --column=Action --column=Description \
            test "Test the configured host and Steam access" \
            setup "Enable or repair passwordless access" \
            remove "Remove passwordless access" \
            fingerprint "Show the host SSH fingerprint" \
            help "How to install SSH Server on Windows or Linux")" || exit 0
    elif [[ "$MODE" == "gui" ]] && command -v kdialog >/dev/null 2>&1; then
        choice="$(kdialog --title "$PROGRAM_NAME — Connection Settings" --menu "Choose an action" \
            test "Test connection" setup "Enable/repair passwordless access" \
            remove "Remove passwordless access" fingerprint "Show host fingerprint" help "SSH Server help")" || exit 0
    else
        printf '%s\n' '1) Test connection' '2) Enable/repair passwordless access' '3) Remove passwordless access' '4) Show host fingerprint' '5) SSH Server help'
        printf 'Choice: '; IFS= read -r choice
        case "$choice" in 1) choice=test;; 2) choice=setup;; 3) choice=remove;; 4) choice=fingerprint;; 5) choice=help;; *) exit 0;; esac
    fi
    case "$choice" in
        test) COMMAND="test-connection" ;;
        setup) COMMAND="setup-key" ;;
        remove) COMMAND="remove-key" ;;
        fingerprint) COMMAND="show-fingerprint" ;;
        help) show_ssh_help; exit 0 ;;
        *) exit 0 ;;
    esac
}

load_state() {
    local line key value
    [[ -f "$STATE_FILE" ]] || return 1
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="$(trim_value "$line")"
        [[ -z "$line" || "$line" == \#* || "$line" != *=* ]] && continue
        key="$(trim_value "${line%%=*}")"
        value="$(trim_value "${line#*=}")"
        case "$key" in
            state_version) STATE_VERSION="$value" ;;
            host) STATE_HOST="$value" ;;
            user) STATE_USER="$value" ;;
            port) STATE_PORT="$value" ;;
            host_key_fingerprint) STATE_HOST_KEY_FINGERPRINT="$value" ;;
            host_platform) STATE_HOST_PLATFORM="$value" ;;
            host_steam_path) STATE_HOST_STEAM_PATH="$value" ;;
        esac
    done <"$STATE_FILE"
}

write_host_state() {
    local platform="$1" steam_path="$2" temporary_state state_dir
    state_dir="${STATE_FILE%/*}"
    [[ "$state_dir" != "$STATE_FILE" ]] || state_dir="."
    umask 077
    mkdir -p -- "$state_dir" || fail 6 "Could not create state directory: $state_dir"
    temporary_state="$(mktemp "$state_dir/.host-state.XXXXXX")" || fail 6 "Could not create host state."
    {
        printf '# Automatically generated. Delete this file to repeat host discovery.\n'
        printf 'state_version=1\n'
        printf 'host=%s\n' "$REMOTE_HOST"
        printf 'user=%s\n' "$REMOTE_USER"
        printf 'port=%s\n' "$REMOTE_PORT"
        printf 'host_key_fingerprint=%s\n' "$CURRENT_HOST_FINGERPRINT"
        printf 'host_platform=%s\n' "$platform"
        printf 'host_steam_path=%s\n' "$steam_path"
    } >"$temporary_state"
    chmod 0600 "$temporary_state"
    mv -- "$temporary_state" "$STATE_FILE" || fail 6 "Could not install host state at $STATE_FILE."
    STATE_WRITTEN=1
}

write_initial_config() {
    local initial_host="$1" initial_user="$2" initial_port="$3"
    local config_dir temporary_config
    config_dir="${CONFIG_FILE%/*}"
    [[ "$config_dir" != "$CONFIG_FILE" ]] || config_dir="."
    umask 077
    mkdir -p -- "$config_dir" || fail 2 "Could not create configuration directory: $config_dir"
    temporary_config="$(mktemp "$config_dir/.config.XXXXXX")" || fail 2 "Could not create a temporary configuration file."
    {
        printf '# Configuration format version.\n'
        printf 'config_version=1\n\n'
        printf '# Hostname or IP address of the computer whose Steam artwork will be pulled.\n'
        printf 'host=%s\n\n' "$initial_host"
        printf '# SSH username on the host computer.\n'
        printf 'user=%s\n\n' "$initial_user"
        printf '# SSH server port on the host computer.\n'
        printf 'port=%s\n\n' "$initial_port"
        printf '# Optional explicit Steam root on this client. This takes precedence over discovery.\n'
        printf '# client_steam_path=/home/USERNAME/.local/share/Steam\n\n'
        printf '# Optional numeric userdata ID. When omitted, every ID present on both systems is synced.\n'
        printf '# steam_user_id=123456789\n\n'
        printf '# Optional conflict policy: preserve-client or host-wins. The default is preserve-client.\n'
        printf '# conflict_policy=preserve-client\n\n'
        printf '# Optional Steam restart policy: ask, always, or never. The default is ask.\n'
        printf '# restart_policy=ask\n\n'
        printf '# Optional SSH connection timeout in seconds. The default is 7.\n'
        printf '# connect_timeout=7\n'
    } >"$temporary_config"
    chmod 0600 "$temporary_config"
    mv -- "$temporary_config" "$CONFIG_FILE" || fail 2 "Could not install configuration at $CONFIG_FILE."
}

init_config() {
    local initial_host initial_user initial_port
    if [[ -e "$CONFIG_FILE" ]]; then
        fail 2 "Configuration already exists at $CONFIG_FILE. It was not changed; edit that file directly."
    fi
    [[ "$MODE" != "headless" ]] || fail 2 "The init command is interactive and cannot run in non-interactive mode."
    if [[ "$MODE" == "gui" ]]; then
        initial_host="$(gui_entry "$PROGRAM_NAME setup" "Windows or Linux host name/address:" "")" || exit 1
        initial_user="$(gui_entry "$PROGRAM_NAME setup" "SSH username on the host:" "")" || exit 1
        initial_port="$(gui_entry "$PROGRAM_NAME setup" "SSH port:" "22")" || exit 1
    else
        printf 'Host name or address: '; IFS= read -r initial_host
        printf 'SSH username: '; IFS= read -r initial_user
        printf 'SSH port [22]: '; IFS= read -r initial_port; initial_port="${initial_port:-22}"
    fi
    initial_host="$(trim_value "$initial_host")"
    initial_user="$(trim_value "$initial_user")"
    initial_port="$(trim_value "$initial_port")"
    [[ -n "$initial_host" ]] || fail 2 "Host name/address is required."
    [[ -n "$initial_user" ]] || fail 2 "SSH username is required."
    [[ "$initial_port" =~ ^[0-9]+$ ]] && ((initial_port >= 1 && initial_port <= 65535)) || fail 2 "SSH port must be between 1 and 65535."
    write_initial_config "$initial_host" "$initial_user" "$initial_port"
    show_info "Configuration created at:
$CONFIG_FILE

Start Steam on the host before the first connection. The detected host platform and Steam path will be saved on this client automatically."
}

if [[ "$COMMAND" == "ssh-help" ]]; then show_ssh_help; exit 0; fi
if [[ "$COMMAND" == "init" ]]; then init_config; exit 0; fi
if [[ "$COMMAND" == "show-config" ]]; then
    [[ -f "$CONFIG_FILE" ]] || fail 2 "Configuration does not exist at $CONFIG_FILE. Run '$PROGRAM_COMMAND init'."
    printf 'Configuration: %s\n\n' "$CONFIG_FILE"
    cat -- "$CONFIG_FILE"
    exit 0
fi

if [[ ! -f "$CONFIG_FILE" ]]; then
    if [[ "$MODE" == "gui" ]]; then
        if confirm_action "No configuration exists at:
$CONFIG_FILE

Create it now?" "Set Up" "Cancel"; then init_config; else exit 2; fi
    elif [[ -z "$CLI_HOST" && -z "${STEAM_GRID_HOST:-}" ]]; then
        fail 2 "Configuration does not exist at $CONFIG_FILE. Run '$PROGRAM_COMMAND init', or supply connection options explicitly."
    fi
fi
[[ -f "$CONFIG_FILE" ]] && load_config

[[ -z "$CFG_CONFIG_VERSION" || "$CFG_CONFIG_VERSION" == "1" ]] || fail 2 "Unsupported config_version in $CONFIG_FILE."
if [[ "$COMMAND" == "connection-settings" ]]; then connection_settings_menu; fi

REMOTE_HOST="${CLI_HOST:-${STEAM_GRID_HOST:-${CFG_HOST:-}}}"
REMOTE_USER="${CLI_USER:-${STEAM_GRID_USER:-${CFG_USER:-}}}"
REMOTE_PORT="${CLI_PORT:-${STEAM_GRID_PORT:-${CFG_PORT:-22}}}"
HOST_PLATFORM="${CLI_HOST_PLATFORM:-${STEAM_GRID_HOST_PLATFORM:-${CFG_HOST_PLATFORM:-auto}}}"
WINDOWS_HOST_STEAM_PATH="${CLI_WINDOWS_HOST_STEAM_PATH:-${STEAM_GRID_WINDOWS_HOST_STEAM_PATH:-${CFG_WINDOWS_HOST_STEAM_PATH:-}}}"
LINUX_HOST_STEAM_PATH="${CLI_LINUX_HOST_STEAM_PATH:-${STEAM_GRID_LINUX_HOST_STEAM_PATH:-${CFG_LINUX_HOST_STEAM_PATH:-}}}"
CLIENT_STEAM_PATH="${CLI_CLIENT_STEAM_PATH:-${STEAM_GRID_CLIENT_STEAM_PATH:-${CFG_CLIENT_STEAM_PATH:-}}}"
STEAM_USER_ID="${CLI_STEAM_USER_ID:-${STEAM_GRID_USER_ID:-${CFG_STEAM_USER_ID:-}}}"
CONFLICT_POLICY="${CLI_CONFLICT_POLICY:-${STEAM_GRID_CONFLICT_POLICY:-${CFG_CONFLICT_POLICY:-preserve-client}}}"
RESTART_POLICY="${RESTART_OVERRIDE:-${CLI_RESTART_POLICY:-${STEAM_GRID_RESTART_POLICY:-${CFG_RESTART_POLICY:-ask}}}}"
CONNECT_TIMEOUT="${CLI_CONNECT_TIMEOUT:-${STEAM_GRID_CONNECT_TIMEOUT:-${CFG_CONNECT_TIMEOUT:-7}}}"

[[ -n "$REMOTE_HOST" ]] || fail 2 "Host is missing. Run '$PROGRAM_COMMAND init' or use --host."
[[ -n "$REMOTE_USER" ]] || fail 2 "SSH user is missing. Run '$PROGRAM_COMMAND init' or use --user."
[[ "$REMOTE_PORT" =~ ^[0-9]+$ ]] && ((REMOTE_PORT >= 1 && REMOTE_PORT <= 65535)) || fail 2 "SSH port must be between 1 and 65535."
[[ "$CONNECT_TIMEOUT" =~ ^[0-9]+$ ]] && ((CONNECT_TIMEOUT >= 1)) || fail 2 "Connection timeout must be a positive integer."
[[ "$HOST_PLATFORM" == "auto" || "$HOST_PLATFORM" == "windows" || "$HOST_PLATFORM" == "linux" ]] || fail 2 "Host platform must be auto, windows, or linux."
[[ "$CONFLICT_POLICY" == "preserve-client" || "$CONFLICT_POLICY" == "host-wins" ]] || fail 2 "Conflict policy must be preserve-client or host-wins."
[[ "$RESTART_POLICY" == "ask" || "$RESTART_POLICY" == "always" || "$RESTART_POLICY" == "never" ]] || fail 2 "Restart policy must be ask, always, or never."
