cp -p "$path" "$path.steam-grid-sync.backup"
temporary="$(mktemp "$HOME/.ssh/.authorized_keys.XXXXXX")"
awk -v marker="$marker" 'index($0, marker) == 0' "$path" >"$temporary"
printf '%s\n' "$line" >>"$temporary"
