        for candidate in "$cwd" "$(dirname "$exe" 2>/dev/null)" "$(dirname "$(dirname "$exe" 2>/dev/null)" 2>/dev/null)" "$compat_root" "$flatpak_root" "$snap_root"; do
            if valid_root "$candidate"; then printf '%s\n' "$(readlink -f "$candidate")"; exit 0; fi
        done
